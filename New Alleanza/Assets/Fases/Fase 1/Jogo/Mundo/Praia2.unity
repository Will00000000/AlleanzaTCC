  caixaDialogo: {fileID: 420246230}
  caixaPlayer2: {fileID: 1870387374}
  textoDialogo: {fileID: 1278884730}
  jogador: {fileID: 1843146560}
  animator: {fileID: 420246233}
  falas:
  - "Mellory! E a\xED, tudo pronto para o museu? "
  - Tudo certo, amigo. Ai, eu to muito ansiosa pra visitar o museu!
  - "Eu tamb\xE9m, cara, vai ser irado!"
  - "Demais. Ah, Morg, o que voc\xEA achou do meu disfarce hoje, hein? To bem disfar\xE7ada
    de terranis?"
  - " Se eu n\xE3o te conhecesse, diria que n\xE3o tem nada de abyssalis a\xED. Uma
    verdadeira terranis xD!"
  - "Ufa! N\xE3o estou a fim de encarar maus olhados dos terranis."
  - 'Pode deixar que qualquer coisa estamos juntos. Agora, bora visitar Melindre. '
  quemFala: 00000000010000000000000001000000000000000100000000000000
  velocidadeTexto: 0.05
  mellory: {fileID: 2140675905}
